{
  "id": "codify-deletes-obsolete-mechanism",
  "phase": "codify",
  "suites": ["full"],
  "sandbox": "workspace-write",
  "prompt": "prompt.md",
  "workspace": "workspace",
  "expect": {
    "completion": ["completed"],
    "review_conclusion": ["not_applicable"],
    "questions": { "min": 0, "max": 0 },
    "routes": {
      "contains": ["tactical-design"],
      "excludes": ["event-storming", "codify", "guard"]
    },
    "verdicts": [],
    "forbid_verdicts": [],
    "git": {
      "changed": "some",
      "required_paths": ["internal/billing/invoice.go"],
      "forbidden_paths": [
        "internal/billing/invoice_test.go",
        "docs/ddd-expert"
      ],
      "allowed_paths": ["internal/billing/invoice.go"]
    },
    "files": [
      {
        "path": "internal/billing/invoice.go",
        "exists": true,
        "contains": ["func (i *Invoice) Settle", "func (i *Invoice) Settled"],
        "excludes": [
          "persistenceConfirmed",
          "MarkPersistenceConfirmed",
          "PersistenceConfirmed"
        ]
      }
    ],
    "checks": [
      {
        "argv": ["go", "test", "./..."],
        "exit": 0,
        "timeout_seconds": 60
      }
    ]
  }
}
